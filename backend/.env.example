APP_NAME=Nimbus
BASE_URL=http://localhost:5173

# PostgreSQL connection. Fill these in before running migrations.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nimbus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Use verify-full for certificate-verified remote connections.
POSTGRES_SSLMODE=prefer
SESSION_HOURS=12

# Initial employee PINs: set two six-digit values before alembic upgrade head.
# Clear these after the seed migration succeeds.
SEED_HOM_PIN=
SEED_PEACH_PIN=

# Optional Argmax Pro settings (inactive with SPEECH_PROVIDER=whisperkit).
# ARGMAX_TOKEN: runtime API key (ax_...), not the SDK download token (axst_...).
# ARGMAX_BINARY_PATH: absolute path to your Argmax Pro server executable.
ARGMAX_TOKEN=
ARGMAX_BINARY_PATH=
ARGMAX_BASE_URL=ws://127.0.0.1:50060/v1/listen
ARGMAX_MODEL=parakeet-v3_494MB
ARGMAX_MODEL_REPO=argmaxinc/parakeetkit-pro
BONSAI_BASE_URL=http://127.0.0.1:18080/v1
BONSAI_MODEL=bonsai-9b

# Private SDK download token (axst_...), separate from runtime ARGMAX_TOKEN.
ARGMAX_SDK_TOKEN=

# Active OSS WhisperKit setup. No Pro key required.
SPEECH_PROVIDER="whisperkit"
WHISPERKIT_BINARY_PATH=""
WHISPERKIT_SOURCE_PATH=""
WHISPERKIT_MODEL_PATH=""
WHISPERKIT_TOKENIZER_PATH=""
